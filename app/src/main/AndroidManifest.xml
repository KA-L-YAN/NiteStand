<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Permissions used ONLY by the opt-in "Lock-screen auto start" feature (off by default):
        - POST_NOTIFICATIONS: foreground-service notification and the StandBy launch notification
        - FOREGROUND_SERVICE(+_SPECIAL_USE): Android only lets apps observe the phone in the background
          from a foreground service
        - USE_FULL_SCREEN_INTENT: the sanctioned way to show an activity over the lock screen from
          the background (user can revoke it on Android 14+)
        - RECEIVE_BOOT_COMPLETED: restart the watcher after reboot if the user enabled it
        - WAKE_LOCK: keep the CPU awake a few seconds at screen-off to read the orientation and verify the launch
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Short partial wake lock (released within 7 s) while sampling orientation at screen-off and verifying the launch (watcher only). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        Weather (only used when the weather widget is turned on):
        - INTERNET: fetch the forecast from Open-Meteo (no account, no API key)
        - ACCESS_COARSE_LOCATION: only if the user picks "approximate location" instead of a city;
          requested at that moment. City-level accuracy; coordinates are rounded to ~1 km.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Lets diagnostics check whether this device has a screen saver settings page. -->
    <queries>
        <intent>
            <action android:name="android.settings.DREAM_SETTINGS" />
        </intent>
    </queries>

    <!--
        Everything else needs no permission:
        - battery state: sticky ACTION_BATTERY_CHANGED broadcast (no permission)
        - orientation: accelerometer / gravity sensor (no permission at <= 200 Hz)
        - next alarm: AlarmManager.getNextAlarmClock() (no permission)
        - keep screen on: FLAG_KEEP_SCREEN_ON window flag (no wake lock)
        - brightness: per-window screenBrightness override (no WRITE_SETTINGS needed)
        The two android:permission attributes below protect our services so that only the
        system can bind them; they are not permissions requested by the app.
    -->

    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <!-- Location is optional (weather can use a chosen city instead). -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <application
        android:name=".StandByClockApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StandByClock"
        tools:targetApi="37">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.StandByClock">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Mode A: StandBy activity. Orientation is requested at runtime (sensorLandscape while active). -->
        <activity
            android:name=".standby.StandByActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|navigation"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/standby_activity_label"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.standby"
            android:theme="@style/Theme.StandByClock.StandBy" />

        <!-- Mode B: Android screen saver (Dream). -->
        <service
            android:name=".standby.StandByDreamService"
            android:exported="true"
            android:label="@string/dream_label"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/standby_dream" />
        </service>

        <!-- Opt-in lock-screen watcher (see LockScreenWatcherService). -->
        <service
            android:name=".lockscreen.LockScreenWatcherService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows a user-enabled bedside clock over the lock screen when the locked phone is woken while horizontal. Uses the motion sensor only while the lock screen is on." />
        </service>

        <receiver
            android:name=".lockscreen.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- "NiteStand" Quick Settings tile: one-tap StandBy, no charger needed. -->
        <service
            android:name=".standby.StandByTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_standby"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="false" />
        </service>
    </application>
</manifest>
