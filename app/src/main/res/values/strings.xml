    <!-- Setup -->
    <string name="setup_tagline">StandBy Clock turns your Android phone into a bedside display while charging.</string>
    <string name="setup_how_title">How it works</string>
    <string name="setup_step_1">Connect the phone to power.</string>
    <string name="setup_step_2">Lock the phone.</string>
    <string name="setup_step_3">Place it horizontally on a stand.</string>
    <string name="setup_step_4">StandBy Clock will activate.</string>
    <string name="setup_how_note">For StandBy to appear on its own after you lock the phone, either keep StandBy open (tap Start StandBy, then lock) or set StandBy Clock as your screen saver below.</string>
