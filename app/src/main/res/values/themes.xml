<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Framework base theme: Compose Material 3 draws all UI, so no MDC dependency is needed. -->
    <style name="Theme.StandByClock" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="android:colorAccent">@color/brand_amber</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.StandByClock.StandBy">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>
</resources>
